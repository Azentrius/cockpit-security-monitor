{
 "ServerVersion": "29.8.0",
 "FirewallBackend": {
  "Driver": "iptables",
  "Info": [
   [
    "EnableUserlandProxy",
    "true"
   ],
   [
    "UserlandProxyPath",
    "/usr/bin/docker-proxy"
   ]
  ]
 },
 "Driver": "overlayfs",
 "CgroupVersion": "2",
 "SecurityOptions": [
  "name=apparmor,profile=default",
  "name=seccomp,profile=builtin",
  "name=cgroupns"
 ]
}
